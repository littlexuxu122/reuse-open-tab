{
  "manifest_version": 3,
  "name": "重复打开时询问",
  "description": "再次打开同一个页面时先询问。确认后关闭新标签，回到已打开的页面并刷新。",
  "version": "1.0.0",
  "minimum_chrome_version": "102",
  "permissions": ["tabs", "scripting", "storage", "notifications"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "重复打开时询问",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
